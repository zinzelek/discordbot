# ==========================================
# KONFIGURACJA BOTA DISCORD INSTALING
# ==========================================

# 1. Twój Token bota Discord (pobrany z https://discord.com/developers/applications)
DISCORD_TOKEN=TUTAJ_WKLEJ_SWOJ_TOKEN_BOTA

# 2. Baza danych Firebase Realtime Database (domyślnie ta sama co w userscripcie)
FIREBASE_DATABASE_URL=https://instaling-bot-2362a-default-rtdb.europe-west1.firebasedatabase.app

# 3. Tryb przeglądarki:
# True = cicho w tle (rekomendowane, zero wyskakujących okien)
# False = widać przeglądarkę na żywo jak bot klika (dobre do testów)
HEADLESS=True

# 4. Godzina codziennej automatycznej sesji (format 24h, np. 7:00 rano)
DEFAULT_AUTO_HOUR=7
DEFAULT_AUTO_MINUTE=0

# 5. Ograniczenie do 1 rangi (tylko użytkownicy z tą rolą mogą używać bota)
# Wpisz nazwę rangi (np. VIP) LUB jej ID z Discorda.
# Administratorzy serwera mają dostęp zawsze.
REQUIRED_ROLE_NAME=VIP
REQUIRED_ROLE_ID=0

